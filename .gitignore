# Keep only the registered active and locked-evaluation artifacts.
artifacts/active/*
!artifacts/active/uptrend_predictions.parquet
artifacts/audit/*
!artifacts/audit/locked_evaluation.parquet

# Keep exactly one artifact and one metrics file per reference model.
research/reference_models/artifacts/*
!research/reference_models/artifacts/*.parquet
research/reference_models/metrics/*
!research/reference_models/metrics/*.csv
